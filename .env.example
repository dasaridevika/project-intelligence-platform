# ==============================================================================
# PROJECT INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide real credentials for local / deployment environments
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="Project Intelligence Platform"
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_64_char_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Service-to-Service Authentication
# Used to protect internal endpoints: /internal/v1/outbox/*
INTERNAL_API_KEY=change_this_to_a_strong_internal_service_key

# PostgreSQL Database Configuration
# Async connection URL used by FastAPI & Consumer (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_intelligence
# Sync connection URL used by Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_intelligence
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_MAX_CONNECTIONS=50

# Search Providers Configuration
# Provider 1: Exa API
EXA_API_KEY=your_exa_api_key_here
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=15
EXA_MAX_RESULTS=20

# Provider 2: Configurable Secondary Provider (e.g. Brave Search / Tavily / Serper)
SECOND_PROVIDER_NAME=brave
SECOND_PROVIDER_API_KEY=your_secondary_search_api_key_here
SECOND_PROVIDER_BASE_URL=https://api.search.brave.com/res/v1/web/search
SECOND_PROVIDER_TIMEOUT_SECONDS=15
SECOND_PROVIDER_MAX_RESULTS=20

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_QUEUE_NAME=project-search-jobs
CLOUDFLARE_DLQ_NAME=project-search-jobs-dlq

# Cloudflare Pull Consumer Settings
CONSUMER_POLL_INTERVAL_SECONDS=2
CONSUMER_MAX_BATCH_SIZE=10
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=60
CONSUMER_MAX_RETRIES=3

# Gateway & CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://project-intelligence.workers.dev"]
RATE_LIMIT_PER_MINUTE=120
