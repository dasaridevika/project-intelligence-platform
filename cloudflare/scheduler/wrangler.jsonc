{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-intelligence-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      {
        "queue": "project-search-jobs",
        "binding": "SEARCH_QUEUE"
      }
    ]
  },
  "vars": {
    "BACKEND_API_URL": "http://127.0.0.1:8000",
    "INTERNAL_API_KEY": "change_this_to_a_strong_internal_service_key"
  }
}
